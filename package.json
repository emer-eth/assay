{
  "name": "assay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "spike": "tsx --env-file=.env scripts/spike.ts",
    "deploy:escrow": "tsx --env-file=.env scripts/deploy-escrow.ts",
    "deploy:escrow:mainnet": "tsx --env-file=.env.mainnet scripts/deploy-escrow.ts",
    "deploy:intents": "tsx --env-file=.env scripts/deploy-intents.ts",
    "demo:voice": "node --env-file=.env scripts/voice.mjs --script demo-video/script.json && node demo-video/vo.mjs && node demo-video/assemble.mjs",
    "demo:intents": "tsx --env-file=.env scripts/demo-intents.ts",
    "jobs": "tsx --env-file=.env scripts/run-jobs.ts"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.11.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@walletconnect/sign-client": "^2.26.0",
    "lenis": "^1.3.11",
    "near-api-js": "^7.4.0",
    "near-connect-hooks": "^1.1.6",
    "next": "16.4.5",
    "openai": "^7.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
