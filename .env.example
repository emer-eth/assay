# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# NEAR AI Cloud (https://cloud.near.ai): create an API key in the dashboard.
# Free $10 of credits: join NEAR Builders (https://nearbuilders.org/join).
NEAR_AI_API_KEY=

# Optional model overrides (see https://cloud-api.near.ai/v1/models)
# NEAR_AI_AGENT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# NEAR_AI_REVIEWER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# Which network this deployment runs on: testnet (default) or mainnet. One deployment per network, so a
# testnet deployment never holds mainnet keys. Set it at build time too (it's built into the browser code).
# NEXT_PUBLIC_NEAR_NETWORK=testnet
# NEXT_PUBLIC_OTHER_NETWORK_URL=   the other deployment's address, for the Mainnet/Testnet switch in the header

# The account that coordinates the swarm (agents become agent-1.<this account>), on that network:
# ending in .testnet for testnet (free at https://testnet.mynearwallet.com), .near for mainnet (real NEAR:
# use a fresh account holding only what the demo needs). Paste its account id and ed25519 private key here.
# The code refuses an account from the other network.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# NEAR_RPC_URL=   default: two FastNEAR endpoints for the network, with failover

# NEAR Intents payments (mainnet only): a 1Click partner key from https://partners.near-intents.org
# (quotes failed without one when tested on 11 Nov 2026). Status lookups work without it.
# ONECLICK_API_KEY=

# Live mode (optional)
# DEMO_NEAR_PER_1K_TOKENS=0.001   demo rate agents pay for their AI, in NEAR per 1,000 tokens
# LIVE_KEY=                       required to use live mode on a deployed site (sent as x-live-key)

# Wallet sign-in
# SESSION_SECRET=                         required on a deployed site (any long random string); locally it's derived from NEAR_PRIVATE_KEY
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   optional: adds a "scan with any wallet" QR code (free ID from https://cloud.reown.com)
# GITHUB_TOKEN=   optional: raises GitHub's rate limit for contract reviews (read-only, public repos)
