# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# NEAR AI Cloud (https://cloud.near.ai): create an API key in the dashboard.
# Free $10 of credits: join NEAR Builders (https://nearbuilders.org/join).
NEAR_AI_API_KEY=

# Optional model overrides (see https://cloud-api.near.ai/v1/models)
# NEAR_AI_AGENT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# NEAR_AI_REVIEWER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# A TESTNET account that coordinates the swarm (agents become agent-1.<this account>).
# Create one free at https://testnet.mynearwallet.com or with near-cli, then paste its account id
# and its ed25519 private key here. Testnet only: the code refuses non-.testnet accounts.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# NEAR_RPC_URL=https://rpc.testnet.fastnear.com   (default: two FastNEAR testnet endpoints with failover)

# Live mode (optional)
# DEMO_NEAR_PER_1K_TOKENS=0.001   demo rate agents pay for their AI, in NEAR per 1,000 tokens
# LIVE_KEY=                       required to use live mode on a deployed site (sent as x-live-key)

# Wallet sign-in
# SESSION_SECRET=                         required on a deployed site (any long random string); locally it's derived from NEAR_PRIVATE_KEY
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   optional: adds a "scan with any wallet" QR code (free ID from https://cloud.reown.com)
